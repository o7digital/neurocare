---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import SpecialtiesTabs from '../components/SpecialtiesTabs.astro';
import PatientJourney from '../components/PatientJourney.astro';
import AppointmentForm from '../components/AppointmentForm.astro';
import BlogSection from '../components/BlogSection.astro';
import Footer from '../components/Footer.astro';
import { doctorProfile } from '../data/site';
---

<Layout
  title={`${doctorProfile.fullName} | Psiquiatra en San Angel, CDMX`}
  description="Consulta privada de psiquiatria en San Angel, Ciudad de Mexico. Atencion personalizada, confidencial y basada en evidencia."
>
  <Header />
  <main>
    <Hero />
    <ExperienceSection />
    <SpecialtiesTabs />
    <PatientJourney />
    <AppointmentForm />
    <BlogSection />
  </main>
  <Footer />
  <a class="mobile-bottom-cta btn btn-primary md:hidden" href={doctorProfile.doctoraliaUrl}>Agendar consulta</a>
</Layout>
