---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import SpecialtiesTabs from '../components/SpecialtiesTabs.astro';
import PatientJourney from '../components/PatientJourney.astro';
import AppointmentForm from '../components/AppointmentForm.astro';
import BlogSection from '../components/BlogSection.astro';
import Footer from '../components/Footer.astro';
import { doctorProfile } from '../data/site';
---

<Layout
  title={`${doctorProfile.brandName} | Psiquiatria y Neuropsiquiatria en San Angel`}
  description="Atencion especializada para trastornos psiquiatricos y neuropsiquiatricos en San Angel, CDMX. Consulta presencial y en linea."
>
  <Header />
  <main>
    <Hero />
    <ExperienceSection />
    <SpecialtiesTabs />
    <PatientJourney />
    <AppointmentForm />
    <BlogSection />
  </main>
  <Footer />
  <a class="mobile-bottom-cta btn btn-primary md:hidden" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">Agendar consulta</a>
</Layout>
