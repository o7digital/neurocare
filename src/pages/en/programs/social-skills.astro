---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import GroupProgram from "../../../components/GroupProgram.astro";
import Footer from "../../../components/Footer.astro";
const alternateUrls = {
  es: new URL("/programas/habilidades-sociales/", Astro.site).toString(),
  en: new URL("/en/programs/social-skills/", Astro.site).toString(),
  default: new URL("/programas/habilidades-sociales/", Astro.site).toString(),
};
---

<Layout
  title="Social skills group | Neuro Diversa"
  description="Explore the proposed social skills program for young adults aged 18–35 in San Ángel, Mexico City."
  schemaType="WebPage"
  alternateUrls={alternateUrls}
>
  <Header />
  <main>
    <GroupProgram expanded />
  </main>
  <Footer />
</Layout>
