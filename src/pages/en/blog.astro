---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import Footer from '../../components/Footer.astro';

const alternateUrls = {
  es: new URL('/blog/', Astro.site).toString(),
  en: new URL('/en/blog/', Astro.site).toString(),
  default: new URL('/blog/', Astro.site).toString(),
};
---

<Layout
  title="Psychiatry and Neuropsychiatry Blog | Neuro Diversa"
  description="Articles about psychiatry, neuropsychiatry, anxiety, ADHD, sleep and mental health from Neuro Diversa in San Angel, Mexico City."
  alternateUrls={alternateUrls}
  lang="en"
  ogLocale="en_US"
>
  <Header />
  <BlogIndex />
  <Footer />
</Layout>
