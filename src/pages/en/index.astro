---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import TeamSection from '../../components/TeamSection.astro';
import GroupProgram from '../../components/GroupProgram.astro';
import SpecialtiesTabs from '../../components/SpecialtiesTabs.astro';
import PatientJourney from '../../components/PatientJourney.astro';
import AppointmentForm from '../../components/AppointmentForm.astro';
import BlogSection from '../../components/BlogSection.astro';
import Footer from '../../components/Footer.astro';
import { getSiteContent } from '../../data/site';

const { doctorProfile, ui } = getSiteContent(Astro.url.pathname);
---

<Layout
  title="Neuro Diversa | Psychiatry, Psychology and Neurodiversity in San Ángel"
  description="A space for psychiatry and psychology in San Ángel, Mexico City. Meet the team and explore individual care and our proposed social skills group."
  schemaType="WebPage"
  lang="en"
  ogLocale="en_US"
>
  <Header />
  <main>
    <Hero />
    <TeamSection />
    <GroupProgram />
    <SpecialtiesTabs />
    <PatientJourney />
    <AppointmentForm />
    <BlogSection />
  </main>
  <Footer />
  <a class="mobile-bottom-cta btn btn-primary md:hidden" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">{ui.book}</a>
</Layout>
