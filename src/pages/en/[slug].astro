---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { articlePages, englishArticlePages, englishServicePages, getSiteContent, servicePages } from '../../data/site';

export function getStaticPaths() {
  return [
    ...englishArticlePages.map((page) => ({
      params: { slug: page.slug },
      props: { page, pageType: 'article' },
    })),
    ...englishServicePages.map((page) => ({
      params: { slug: page.slug },
      props: { page, pageType: 'service' },
    })),
  ];
}

const { page, pageType } = Astro.props;
const { doctorProfile } = getSiteContent(Astro.url.pathname);
const pages = pageType === 'service' ? englishServicePages : englishArticlePages;
const spanishPages = pageType === 'service' ? servicePages : articlePages;
const pageIndex = pages.findIndex((item) => item.slug === page.slug);
const spanishPage = spanishPages[pageIndex];
const alternateUrls = {
  es: new URL(spanishPage.href, Astro.site).toString(),
  en: new URL(page.href, Astro.site).toString(),
  default: new URL(spanishPage.href, Astro.site).toString(),
};
---

<Layout
  title={`${page.title} | ${doctorProfile.brandName}`}
  description={`${page.description} Psychiatric and neuropsychiatric care in San Angel, Mexico City.`}
  alternateUrls={alternateUrls}
  schemaType="Article"
  lang="en"
  ogLocale="en_US"
>
  <Header />
  <main class="section-premium bg-paper">
    <article class="container-premium max-w-4xl">
      <p class="eyebrow">{page.category}</p>
      <h1 class="section-title">{page.title}</h1>
      <p class="lead">{page.description}</p>

      <div class="mt-10 space-y-8 text-muted">
        {page.sections.map(([heading, body]) => (
          <section>
            <h2 class="mb-3 text-2xl font-semibold text-text">{heading}</h2>
            <p>{body}</p>
          </section>
        ))}
      </div>

      <div class="mt-12 flex flex-wrap gap-3 border-t border-sand pt-8">
        <a class="btn btn-primary" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">Book an appointment</a>
        <a class="btn btn-secondary" href={pageType === 'service' ? '/en/#motivos' : '/en/blog/'}>{pageType === 'service' ? 'View reasons for consultation' : 'Back to the blog'}</a>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
