---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { articlePages, englishArticlePages, getSiteContent } from '../../data/site';

export function getStaticPaths() {
  return englishArticlePages.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { doctorProfile } = getSiteContent(Astro.url.pathname);
const articleIndex = englishArticlePages.findIndex((item) => item.slug === article.slug);
const spanishArticle = articlePages[articleIndex];
const alternateUrls = {
  es: new URL(spanishArticle.href, Astro.site).toString(),
  en: new URL(article.href, Astro.site).toString(),
  default: new URL(spanishArticle.href, Astro.site).toString(),
};
---

<Layout
  title={`${article.title} in San Angel Mexico City | ${doctorProfile.brandName}`}
  description={`${article.description} Psychiatric and neuropsychiatric care in San Angel, Mexico City.`}
  alternateUrls={alternateUrls}
  schemaType="Article"
  lang="en"
  ogLocale="en_US"
>
  <Header />
  <main class="section-premium bg-paper">
    <article class="container-premium max-w-4xl">
      <p class="eyebrow">{article.category}</p>
      <h1 class="section-title">{article.title}</h1>
      <p class="lead">{article.description}</p>

      <div class="mt-10 space-y-8 text-muted">
        {article.sections.map(([heading, body]) => (
          <section>
            <h2 class="mb-3 text-2xl font-semibold text-text">{heading}</h2>
            <p>{body}</p>
          </section>
        ))}
      </div>

      <div class="mt-12 flex flex-wrap gap-3 border-t border-sand pt-8">
        <a class="btn btn-primary" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">Book an appointment</a>
        <a class="btn btn-secondary" href="/en/#articulos">Back to articles</a>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
