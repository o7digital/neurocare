---
import Layout from "../layouts/Layout.astro";
import { articlePages } from "../data/site";
---

<Layout
  title="Espacio editorial · Demo | Neuro Diversa"
  description="Demostración del espacio compartido de publicaciones, programas y redes sociales de Neuro Diversa."
  schemaType="WebPage"
>
  <div class="studio-shell">
    <aside class="studio-sidebar">
      <a href="/" aria-label="Volver a Neuro Diversa">
        <img
          src="/neuro-diversa-logo.webp"
          alt="Neuro Diversa"
          width="863"
          height="399"
        />
      </a>
      <p class="sidebar-label">ESPACIO EDITORIAL</p>
      <nav aria-label="Secciones del espacio editorial">
        <button
          type="button"
          class="studio-nav active"
          data-panel="articles"
          aria-controls="panel-articles"
          aria-current="page"
        >
          <span aria-hidden="true">▤</span> Artículos del sitio
        </button>
        <button
          type="button"
          class="studio-nav"
          data-panel="program"
          aria-controls="panel-program"
        >
          <span aria-hidden="true">◉</span> Programa grupal
        </button>
        <button
          type="button"
          class="studio-nav"
          data-panel="social"
          aria-controls="panel-social"
        >
          <span aria-hidden="true">↗</span> Redes con Buffer
        </button>
      </nav>
      <div class="sidebar-bottom">
        <p>
          Dos profesionales.
          <br />
          <em>Una voz compartida.</em>
        </p>
        <a href="/">Ver el sitio ↗</a>
        <button id="reset-demo" type="button">
          Restablecer esta demo
        </button>
      </div>
    </aside>
    <main class="studio-main">
      <header class="studio-top">
        <p>
          Neuro Diversa <span>/</span>{" "}
          <span id="breadcrumb">Artículos del sitio</span>
        </p>
        <span class="demo-pill">DEMO INTERACTIVA</span>
      </header>
      <div class="studio-heading">
        <div>
          <span class="eyebrow">Crear, cuidar, compartir</span>
          <h1>Tu espacio para compartir.</h1>
          <p>
            Información en tu sitio y contenidos para tus redes, desde un mismo
            lugar.
          </p>
        </div>
        <label class="author-view">
          Vista de autora
          <select id="author-view">
            <option value="Dra. Ariadna Mondragón">
              Dra. Ariadna Mondragón
            </option>
            <option value="Psicóloga colaboradora (perfil pendiente)">
              Psicóloga colaboradora
            </option>
          </select>
        </label>
      </div>
      <div class="studio-demo-note">
        <strong>Esta es una demostración abierta.</strong> Los cambios se
        guardan solo en este navegador. Los dos accesos privados, el backend y
        la conexión con Buffer se implementarán en la versión final. No
        introduzcas datos de pacientes ni credenciales.
      </div>
      <p
        id="studio-status"
        class="studio-status"
        role="status"
        aria-live="polite"
      ></p>
      <section
        id="panel-articles"
        class="studio-panel"
        aria-labelledby="articles-heading"
      >
        <div class="studio-metrics">
          <div>
            <span>Biblioteca actual</span>
            <strong>
              {articlePages.length} <small>artículos en español</small>
            </strong>
          </div>
          <div>
            <span>Tu espacio de prueba</span>
            <strong>
              <span id="draft-count">0</span> <small>borradores</small>
            </strong>
          </div>
          <div>
            <span>Vista previa del blog</span>
            <strong>
              <span id="preview-count">0</span>{" "}
              <small>artículos de prueba</small>
            </strong>
          </div>
        </div>
        <div class="studio-editor-grid">
          <form id="article-form" class="studio-card">
            <div class="card-heading">
              <div>
                <span class="small-label">ARTÍCULO DEL SITIO</span>
                <h2 id="articles-heading">De una idea a una lectura.</h2>
              </div>
              <span class="soft-pill">Ejemplo editable</span>
            </div>
            <input type="hidden" id="post-id" />
            <label for="post-title">Título</label>
            <input
              id="post-title"
              required
              maxlength="150"
              value="Conectar sin dejar de ser tú"
            />
            <div class="form-two">
              <div>
                <label for="post-author">Autora</label>
                <select id="post-author">
                  <option>Dra. Ariadna Mondragón</option>
                  <option>Psicóloga colaboradora (perfil pendiente)</option>
                </select>
              </div>
              <div>
                <label for="post-category">Categoría</label>
                <select id="post-category">
                  <option>Neurodiversidad</option>
                  <option>Habilidades sociales</option>
                  <option>Psicología</option>
                  <option>Psiquiatría</option>
                </select>
              </div>
            </div>
            <label for="post-body">Contenido</label>
            <textarea
              id="post-body"
              rows="9"
              required
              maxlength="15000"
            >No existe una sola manera de relacionarnos. Reconocer nuestros intereses, necesidades y límites puede ser un punto de partida para explorar nuestros vínculos.

Este es un texto ilustrativo para probar el espacio editorial. El contenido definitivo se preparará y revisará por las profesionales.</textarea>
            <div class="form-actions">
              <button class="btn btn-secondary" type="submit" value="draft">
                Guardar borrador
              </button>
              <button class="btn btn-primary" type="submit" value="preview">
                Mostrar en el blog de prueba ↗
              </button>
            </div>
            <p class="field-help">
              Solo visible en tu navegador. No publica en neurodiversa.mx.
            </p>
          </form>
          <aside class="studio-card article-preview">
            <span class="small-label">ASÍ SE VERÁ TU ARTÍCULO</span>
            <span id="preview-category" class="preview-category">
              Neurodiversidad
            </span>
            <h2 id="live-title">Conectar sin dejar de ser tú</h2>
            <p id="live-author" class="preview-author">
              Dra. Ariadna Mondragón
            </p>
            <p id="live-body" class="preview-body"></p>
            <div class="preview-brand">
              NEURO DIVERSA <span>Un espacio para comprenderte.</span>
            </div>
          </aside>
        </div>
        <div class="studio-card saved-card">
          <div class="card-heading">
            <h2>Tus contenidos de prueba</h2>
            <a href="/blog/#demo-posts">Abrir blog de prueba ↗</a>
          </div>
          <div id="saved-posts"></div>
          <button type="button" id="new-post" class="text-button">
            + Empezar otro artículo
          </button>
        </div>
      </section>
      <section
        id="panel-program"
        class="studio-panel"
        hidden
        aria-labelledby="program-heading"
      >
        <div class="studio-editor-grid">
          <form id="program-form" class="studio-card">
            <span class="small-label">EXPERIENCIAS GRUPALES</span>
            <h2 id="program-heading">Un programa que puede crecer.</h2>
            <p class="card-lead">
              Actualiza la propuesta y comprueba cómo se refleja en la página
              del grupo, dentro de esta demo.
            </p>
            <label for="program-title">Nombre del programa</label>
            <input
              id="program-title"
              required
              maxlength="120"
              value="Habilidades sociales. Conexiones reales."
            />
            <label for="program-start">Inicio propuesto</label>
            <input
              id="program-start"
              required
              maxlength="60"
              value="Enero 2027*"
            />
            <div class="form-two">
              <div>
                <label for="program-weeks">Duración en semanas</label>
                <input
                  id="program-weeks"
                  type="number"
                  min="1"
                  max="52"
                  required
                  value="16"
                />
              </div>
              <div>
                <label for="program-minutes">Minutos por sesión</label>
                <input
                  id="program-minutes"
                  type="number"
                  min="15"
                  max="240"
                  step="5"
                  required
                  value="90"
                />
              </div>
            </div>
            <div class="form-actions">
              <button class="btn btn-primary" type="submit">
                Guardar en esta demo
              </button>
              <a
                class="btn btn-secondary"
                href="/programas/habilidades-sociales/"
              >
                Ver programa ↗
              </a>
            </div>
          </form>
          <aside class="studio-card program-summary">
            <span class="small-label">LA PROPUESTA INICIAL</span>
            <div class="program-symbol" aria-hidden="true">
              ◌
            </div>
            <h2>
              Aprender a relacionarnos,
              <br />
              <em>respetando quiénes somos.</em>
            </h2>
            <ul>
              <li>Jóvenes adultos de 18 a 35 años</li>
              <li>Sesiones grupales los viernes</li>
              <li>Modalidad presencial en San Ángel</li>
              <li>Facilitadoras, costos y cupo por confirmar</li>
            </ul>
            <p class="field-help">
              Información tomada del material de referencia. El uso del nombre
              PEERS® y las menciones a UCLA se validarán con la cliente antes de
              la publicación definitiva.
            </p>
          </aside>
        </div>
      </section>
      <section
        id="panel-social"
        class="studio-panel"
        hidden
        aria-labelledby="social-heading"
      >
        <div class="buffer-banner">
          <div>
            <span class="small-label">DEL SITIO A TUS REDES</span>
            <h2 id="social-heading">Una idea. Más conversaciones.</h2>
            <p>
              Prepara una versión de tu contenido para redes sociales y
              visualiza el paso previsto hacia Buffer.
            </p>
          </div>
          <span class="buffer-status">Buffer · Sin conectar</span>
        </div>
        <div class="studio-editor-grid">
          <form id="social-form" class="studio-card">
            <div class="card-heading">
              <h2>Preparar un post</h2>
              <button type="button" id="reuse-article" class="text-button">
                Usar mi artículo ↗
              </button>
            </div>
            <label for="social-body">Texto para redes</label>
            <textarea
              id="social-body"
              rows="7"
              maxlength="5000"
              required
            >Tu forma de conectar tiene un lugar aquí. 🌿

En Neuro Diversa estamos preparando un espacio grupal para explorar habilidades sociales desde el respeto a distintas formas de ser.

Información del programa por confirmar.</textarea>
            <fieldset>
              <legend>Canales de ejemplo</legend>
              <label class="channel-choice">
                <input
                  type="checkbox"
                  name="channel"
                  value="Instagram"
                  checked
                />{" "}
                <span class="social-icon">◎</span> Instagram
              </label>
              <label class="channel-choice">
                <input
                  type="checkbox"
                  name="channel"
                  value="Facebook"
                  checked
                />{" "}
                <span class="social-icon">f</span> Facebook
              </label>
            </fieldset>
            <label for="social-date">
              Fecha deseada{" "}
              <span class="optional">
                (opcional, hora local de tu dispositivo)
              </span>
            </label>
            <input id="social-date" type="datetime-local" />
            <div class="form-actions">
              <button class="btn btn-secondary" type="submit" value="draft">
                Guardar borrador social
              </button>
              <button class="btn btn-primary" type="submit" value="prepare">
                Preparar para Buffer · Demo ↗
              </button>
            </div>
            <p class="field-help">
              Simulación: no conecta cuentas, no envía datos a Buffer y no
              programa publicaciones reales.
            </p>
          </form>
          <aside class="studio-card">
            <span class="small-label">VISTA PREVIA DEL POST</span>
            <div class="social-account">
              <span>ND</span>
              <div>
                <strong>Neuro Diversa</strong>
                <p>Cuenta ilustrativa · Instagram</p>
              </div>
            </div>
            <div class="social-visual">
              <div aria-hidden="true">◌ ◌</div>
              <p>
                Distintas formas de ser.
                <br />
                <em>Un espacio para conectar.</em>
              </p>
              <span>NEURO DIVERSA</span>
            </div>
            <p id="social-live-body" class="social-live-body"></p>
            <details class="buffer-details">
              <summary>¿Cómo funcionará la conexión real?</summary>
              <p>
                Conectaremos los canales autorizados de la cliente en Buffer.
                Después, podrán preparar los textos y revisar cada publicación
                antes de enviarla a la cola de sus redes. Las imágenes y los
                formatos dependerán del canal conectado.
              </p>
            </details>
          </aside>
        </div>
        <div class="studio-card saved-card">
          <h2>Preparaciones de esta demo</h2>
          <div id="social-drafts"></div>
        </div>
      </section>
    </main>
  </div>
</Layout>
<script>
  import {
    getPosts,
    readDemo,
    writeDemo,
    keys,
    type DemoPost,
    type DemoProgram,
    type SocialDraft,
  } from "../scripts/editorialDemo";
  const el = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const input = (id: string) => el<HTMLInputElement>(id);
  const status = (message: string) => {
    el("studio-status").textContent = message;
  };
  let posts = getPosts();
  const storedSocial = readDemo<unknown>(keys.social, []);
  let social: SocialDraft[] = Array.isArray(storedSocial)
    ? storedSocial.filter(
        (p) =>
          p &&
          typeof p.id === "string" &&
          typeof p.body === "string" &&
          Array.isArray(p.channels) &&
          p.channels.every((c: unknown) => typeof c === "string") &&
          typeof p.date === "string" &&
          typeof p.prepared === "boolean",
      )
    : [];
  const articleForm = el<HTMLFormElement>("article-form");
  const socialForm = el<HTMLFormElement>("social-form");
  const titleInput = input("post-title");
  const bodyInput = el<HTMLTextAreaElement>("post-body");
  const authorInput = el<HTMLSelectElement>("post-author");
  const categoryInput = el<HTMLSelectElement>("post-category");
  const socialBody = el<HTMLTextAreaElement>("social-body");
  const authorView = el<HTMLSelectElement>("author-view");
  function renderArticle() {
    el("live-title").textContent =
      titleInput.value || "El título de tu artículo";
    el("live-author").textContent = authorInput.value;
    el("live-body").textContent = bodyInput.value;
    el("preview-category").textContent = categoryInput.value;
  }
  function renderPosts() {
    el("draft-count").textContent = String(
      posts.filter((p) => p.status === "draft").length,
    );
    el("preview-count").textContent = String(
      posts.filter((p) => p.status === "preview").length,
    );
    const list = el("saved-posts");
    list.replaceChildren();
    if (!posts.length) {
      const p = document.createElement("p");
      p.className = "empty-state";
      p.textContent =
        "Todavía no hay contenidos guardados en esta demo. Prueba con el ejemplo de arriba.";
      list.append(p);
    }
    for (const post of posts) {
      const row = document.createElement("div");
      row.className = "saved-row";
      const text = document.createElement("div");
      const heading = document.createElement("strong");
      heading.textContent = post.title;
      const meta = document.createElement("p");
      meta.textContent = `${post.author} · ${post.status === "draft" ? "Borrador" : "En blog de prueba"}`;
      text.append(heading, meta);
      const actions = document.createElement("div");
      actions.className = "row-actions";
      const edit = document.createElement("button");
      edit.type = "button";
      edit.textContent = "Editar";
      edit.className = "text-button";
      edit.setAttribute("aria-label", `Editar ${post.title}`);
      edit.addEventListener("click", () => {
        input("post-id").value = post.id;
        titleInput.value = post.title;
        bodyInput.value = post.body;
        authorInput.value = post.author;
        categoryInput.value = post.category;
        authorView.value = post.author;
        renderArticle();
        titleInput.focus();
      });
      const remove = document.createElement("button");
      remove.type = "button";
      remove.textContent = "Eliminar";
      remove.className = "text-button";
      remove.setAttribute("aria-label", `Eliminar ${post.title}`);
      remove.addEventListener("click", () => {
        const next = posts.filter((p) => p.id !== post.id);
        if (!writeDemo(keys.posts, next)) {
          status(
            "No se pudo guardar. Revisa si tu navegador permite almacenamiento local.",
          );
          return;
        }
        posts = next;
        if (input("post-id").value === post.id) input("post-id").value = "";
        renderPosts();
        status("Contenido eliminado de esta demo.");
      });
      actions.append(edit, remove);
      row.append(text, actions);
      list.append(row);
    }
  }
  function renderSocial() {
    const list = el("social-drafts");
    list.replaceChildren();
    if (!social.length) {
      const p = document.createElement("p");
      p.className = "empty-state";
      p.textContent =
        "Tus borradores y preparaciones sociales aparecerán aquí. Nada se enviará a las redes.";
      list.append(p);
    }
    for (const draft of social) {
      const row = document.createElement("div");
      row.className = "saved-row";
      const text = document.createElement("div");
      const heading = document.createElement("strong");
      heading.textContent = draft.body.slice(0, 100);
      const meta = document.createElement("p");
      const date = draft.date ? new Date(draft.date) : null;
      meta.textContent = `${draft.channels.join(" + ")} · ${draft.prepared ? "Preparado para Buffer (simulación)" : "Borrador social"}${date && !Number.isNaN(date.getTime()) ? " · " + date.toLocaleString("es-MX") : ""}`;
      text.append(heading, meta);
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "text-button";
      remove.textContent = "Eliminar";
      remove.setAttribute(
        "aria-label",
        `Eliminar borrador social: ${draft.body.slice(0, 40)}`,
      );
      remove.addEventListener("click", () => {
        const next = social.filter((p) => p.id !== draft.id);
        if (!writeDemo(keys.social, next)) {
          status("No se pudo guardar en este navegador.");
          return;
        }
        social = next;
        renderSocial();
        status("Borrador social eliminado de la demo.");
      });
      row.append(text, remove);
      list.append(row);
    }
  }
  document
    .querySelectorAll<HTMLButtonElement>("[data-panel]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        document
          .querySelectorAll<HTMLElement>(".studio-panel")
          .forEach((panel) => {
            panel.hidden = panel.id !== `panel-${button.dataset.panel}`;
          });
        document
          .querySelectorAll<HTMLButtonElement>("[data-panel]")
          .forEach((nav) => {
            nav.classList.toggle("active", nav === button);
            if (nav === button) nav.setAttribute("aria-current", "page");
            else nav.removeAttribute("aria-current");
          });
        el("breadcrumb").textContent = button.textContent?.trim() || "";
        status("");
      }),
    );
  articleForm.addEventListener("input", renderArticle);
  authorView.addEventListener("change", () => {
    authorInput.value = authorView.value;
    renderArticle();
  });
  authorInput.addEventListener("change", () => {
    authorView.value = authorInput.value;
  });
  articleForm.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!titleInput.value.trim() || !bodyInput.value.trim()) {
      status("Escribe un título y contenido antes de guardar.");
      return;
    }
    const action = (event as SubmitEvent).submitter as HTMLButtonElement | null;
    const post: DemoPost = {
      id: input("post-id").value || crypto.randomUUID(),
      title: titleInput.value.trim(),
      body: bodyInput.value.trim(),
      author: authorInput.value,
      category: categoryInput.value,
      status: action?.value === "preview" ? "preview" : "draft",
      updated: new Date().toISOString(),
    };
    const next = [post, ...posts.filter((p) => p.id !== post.id)];
    if (!writeDemo(keys.posts, next)) {
      status(
        "No se pudo guardar. Revisa si tu navegador permite almacenamiento local.",
      );
      return;
    }
    posts = next;
    input("post-id").value = post.id;
    renderPosts();
    status(
      post.status === "preview"
        ? "Artículo guardado en el blog de prueba de este navegador. Puedes verlo con «Abrir blog de prueba»."
        : "Borrador guardado en este navegador.",
    );
  });
  el("new-post").addEventListener("click", () => {
    articleForm.reset();
    input("post-id").value = "";
    titleInput.value = "";
    bodyInput.value = "";
    authorInput.value = authorView.value;
    renderArticle();
    titleInput.focus();
    status("Nuevo artículo.");
  });
  const storedProgram = readDemo<Partial<DemoProgram> | null>(
    keys.program,
    null,
  );
  if (storedProgram && typeof storedProgram === "object") {
    if (typeof storedProgram.title === "string")
      input("program-title").value = storedProgram.title;
    if (typeof storedProgram.start === "string")
      input("program-start").value = storedProgram.start;
    if (typeof storedProgram.weeks === "number")
      input("program-weeks").value = String(storedProgram.weeks);
    if (typeof storedProgram.minutes === "number")
      input("program-minutes").value = String(storedProgram.minutes);
  }
  el<HTMLFormElement>("program-form").addEventListener("submit", (event) => {
    event.preventDefault();
    const p: DemoProgram = {
      title: input("program-title").value.trim(),
      start: input("program-start").value.trim(),
      weeks: Number(input("program-weeks").value),
      minutes: Number(input("program-minutes").value),
    };
    if (!p.title || !p.start) {
      status("Completa el nombre y el inicio propuesto.");
      return;
    }
    status(
      writeDemo(keys.program, p)
        ? "Programa guardado en esta demo. Abre «Ver programa» para comprobar los cambios."
        : "No se pudo guardar en este navegador.",
    );
  });
  socialBody.addEventListener("input", () => {
    el("social-live-body").textContent = socialBody.value;
  });
  el("reuse-article").addEventListener("click", () => {
    socialBody.value = `${titleInput.value}\n\n${bodyInput.value.slice(0, 450)}\n\nMás información en neurodiversa.mx`;
    el("social-live-body").textContent = socialBody.value;
    status(
      "Texto del artículo adaptado como punto de partida. Revísalo antes de preparar el post.",
    );
  });
  socialForm.addEventListener("submit", (event) => {
    event.preventDefault();
    const channels = Array.from(
      socialForm.querySelectorAll<HTMLInputElement>(
        'input[name="channel"]:checked',
      ),
    ).map((c) => c.value);
    if (!channels.length) {
      status("Selecciona al menos un canal de ejemplo.");
      return;
    }
    if (!socialBody.value.trim()) {
      status("Escribe el texto de tu post.");
      return;
    }
    const prepared =
      ((event as SubmitEvent).submitter as HTMLButtonElement | null)?.value ===
      "prepare";
    const next = [
      {
        id: crypto.randomUUID(),
        body: socialBody.value.trim(),
        channels,
        date: input("social-date").value,
        prepared,
      },
      ...social,
    ];
    if (!writeDemo(keys.social, next)) {
      status("No se pudo guardar en este navegador.");
      return;
    }
    social = next;
    renderSocial();
    status(
      prepared
        ? "Preparación guardada como simulación. Buffer sigue sin conectar: no se ha enviado ni programado ninguna publicación."
        : "Borrador social guardado solo en este navegador.",
    );
  });
  el("reset-demo").addEventListener("click", () => {
    try {
      Object.values(keys).forEach((key) => localStorage.removeItem(key));
      location.reload();
    } catch {
      status("No se pudo restablecer el almacenamiento de este navegador.");
    }
  });
  renderArticle();
  renderPosts();
  renderSocial();
