---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BlogIndex from '../components/BlogIndex.astro';
import Footer from '../components/Footer.astro';

const alternateUrls = {
  es: new URL('/blog/', Astro.site).toString(),
  en: new URL('/en/blog/', Astro.site).toString(),
  default: new URL('/blog/', Astro.site).toString(),
};
---

<Layout
  title="Blog de Psiquiatría y Neuropsiquiatría | Neuro Diversa"
  description="Artículos sobre psiquiatría, neuropsiquiatría, ansiedad, TDAH, sueño y salud mental preparados por Neuro Diversa en San Ángel, CDMX."
  alternateUrls={alternateUrls}
>
  <Header />
  <BlogIndex />
  <Footer />
</Layout>
