---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { articlePages, doctorProfile, englishArticlePages } from '../data/site';

export function getStaticPaths() {
  return articlePages.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const articleIndex = articlePages.findIndex((item) => item.slug === article.slug);
const englishArticle = englishArticlePages[articleIndex];
const alternateUrls = {
  es: new URL(article.href, Astro.site).toString(),
  en: new URL(englishArticle.href, Astro.site).toString(),
  default: new URL(article.href, Astro.site).toString(),
};
---

<Layout
  title={`${article.title} en San Angel CDMX | ${doctorProfile.brandName}`}
  description={`${article.description} Atencion psiquiatrica y neuropsiquiatrica en San Angel, CDMX.`}
  alternateUrls={alternateUrls}
  schemaType="Article"
>
  <Header />
  <main class="section-premium bg-paper">
    <article class="container-premium max-w-4xl">
      <p class="eyebrow">{article.category}</p>
      <h1 class="section-title">{article.title}</h1>
      <p class="lead">{article.description}</p>

      <div class="mt-10 space-y-8 text-muted">
        {article.sections.map(([heading, body]) => (
          <section>
            <h2 class="mb-3 text-2xl font-semibold text-text">{heading}</h2>
            <p>{body}</p>
          </section>
        ))}
      </div>

      <div class="mt-12 flex flex-wrap gap-3 border-t border-sand pt-8">
        <a class="btn btn-primary" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">Agendar consulta</a>
        <a class="btn btn-secondary" href="/#articulos">Volver a articulos</a>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
