---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { articlePages, doctorProfile, englishArticlePages, englishServicePages, servicePages } from '../data/site';

export function getStaticPaths() {
  return [
    ...articlePages.map((page) => ({
      params: { slug: page.slug },
      props: { page, pageType: 'article' },
    })),
    ...servicePages.map((page) => ({
      params: { slug: page.slug },
      props: { page, pageType: 'service' },
    })),
  ];
}

const { page, pageType } = Astro.props;
const pages = pageType === 'service' ? servicePages : articlePages;
const englishPages = pageType === 'service' ? englishServicePages : englishArticlePages;
const pageIndex = pages.findIndex((item) => item.slug === page.slug);
const englishPage = englishPages[pageIndex];
const alternateUrls = {
  es: new URL(page.href, Astro.site).toString(),
  en: new URL(englishPage.href, Astro.site).toString(),
  default: new URL(page.href, Astro.site).toString(),
};
---

<Layout
  title={`${page.title} | ${doctorProfile.brandName}`}
  description={`${page.description} Atencion psiquiatrica y neuropsiquiatrica en San Angel, CDMX.`}
  alternateUrls={alternateUrls}
  schemaType="Article"
>
  <Header />
  <main class="section-premium bg-paper">
    <article class="container-premium max-w-4xl">
      <p class="eyebrow">{page.category}</p>
      <h1 class="section-title">{page.title}</h1>
      <p class="lead">{page.description}</p>

      <div class="mt-10 space-y-8 text-muted">
        {page.sections.map(([heading, body]) => (
          <section>
            <h2 class="mb-3 text-2xl font-semibold text-text">{heading}</h2>
            <p>{body}</p>
          </section>
        ))}
      </div>

      <div class="mt-12 flex flex-wrap gap-3 border-t border-sand pt-8">
        <a class="btn btn-primary" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">Agendar consulta</a>
        <a class="btn btn-secondary" href={pageType === 'service' ? '/#motivos' : '/#articulos'}>{pageType === 'service' ? 'Ver motivos de consulta' : 'Volver a articulos'}</a>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
