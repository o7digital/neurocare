---
import { getSiteContent } from '../data/site';

const { doctorProfile, navItems, ui } = getSiteContent(Astro.url.pathname);
const isEnglish = Astro.url.pathname.startsWith('/en');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en/';
const homeHref = isEnglish ? '/en/' : '/';
const sectionHref = (href: string) => isHome ? href : `${homeHref}${href}`;
---

<footer class="bg-burgundy py-16 pb-7 text-cream">
  <div class="container-premium">
    <div class="grid gap-8 border-b border-cream/12 pb-9 md:grid-cols-[1.1fr_0.8fr_0.8fr]">
      <div>
        <a href={isHome ? '#inicio' : homeHref} class="mb-5 inline-flex" aria-label={`${doctorProfile.brandName} inicio`}>
          <img
            class="h-auto w-[190px] max-w-full object-contain sm:w-[220px]"
            src="/neuro-diversa-logo-light.png"
            alt="Neuro Diversa"
            width="863"
            height="399"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="mb-5 max-w-sm text-sm text-cream/62">
          {doctorProfile.specialty}<br />
          {doctorProfile.location}
        </p>
        <a class="btn btn-primary" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">{ui.book}</a>
      </div>
      <div>
        <h4 class="mb-3 font-semibold">{ui.footerNav}</h4>
        {navItems.slice(1, 5).map((item) => <a class="my-2 block text-cream/62 hover:text-cream" href={sectionHref(item.href)}>{item.label}</a>)}
        <a class="my-2 block text-cream/62 hover:text-cream" href={ui.privacyHref}>{ui.footerPrivacy}</a>
      </div>
      <div>
        <h4 class="mb-3 font-semibold">{ui.footerContact}</h4>
        <a class="my-2 block text-cream/62 hover:text-cream" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">Doctoralia</a>
        <a class="my-2 block text-cream/62 hover:text-cream" href={doctorProfile.phoneHref}>{doctorProfile.phoneLabel}</a>
        <a class="my-2 block text-cream/62 hover:text-cream" href={doctorProfile.secondaryPhoneHref}>{doctorProfile.secondaryPhoneLabel}</a>
      </div>
    </div>
    <div class="pt-5 text-xs text-cream/42">
      {ui.footerDisclaimer}
    </div>
  </div>
</footer>
