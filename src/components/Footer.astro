---
import { getSiteContent } from '../data/site';

const { doctorProfile, navItems, ui } = getSiteContent(Astro.url.pathname);
const isEnglish = Astro.url.pathname.startsWith('/en');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en/';
const homeHref = isEnglish ? '/en/' : '/';
const sectionHref = (href: string) => isHome ? href : `${homeHref}${href}`;
const navigationHref = (href: string) => href.startsWith('/') ? href : sectionHref(href);
const footerKeywords = isEnglish
  ? [
      'psychiatrist in San Ángel Mexico City',
      'neuropsychiatrist in San Ángel Mexico City',
      'psychiatric consultation in San Ángel Mexico City',
      'psychiatrist Álvaro Obregón Mexico City',
      'neuropsychiatrist Álvaro Obregón Mexico City',
      'online psychiatric consultation Mexico City',
      'psychiatrist near San Ángel',
      'psychiatrist near me San Ángel Mexico City',
      'anxiety treatment in San Ángel Mexico City',
      'depression treatment in San Ángel Mexico City',
      'adult ADHD San Ángel Mexico City',
      'sleep disorders treatment in San Ángel Mexico City',
      'first psychiatric consultation in San Ángel Mexico City',
      'neuropsychiatric assessment in San Ángel Mexico City',
      'bilingual psychiatrist San Ángel Mexico City',
      'mental health consultation in San Ángel Mexico City',
      'psychotherapy in San Ángel Mexico City',
      'panic attacks treatment in San Ángel Mexico City',
      'cognitive symptoms assessment in San Ángel Mexico City',
      'memory problems assessment in San Ángel Mexico City',
    ]
  : [
      'psiquiatra en San Ángel CDMX',
      'neuropsiquiatra en San Ángel CDMX',
      'consulta psiquiátrica en San Ángel CDMX',
      'psiquiatra Álvaro Obregón CDMX',
      'neuropsiquiatra Álvaro Obregón CDMX',
      'consulta psiquiátrica en línea CDMX',
      'psiquiatra cerca de San Ángel',
      'psiquiatra cerca de mi San Ángel CDMX',
      'tratamiento para ansiedad en San Ángel CDMX',
      'depresión tratamiento en San Ángel CDMX',
      'TDAH en adultos San Ángel CDMX',
      'trastornos del sueño tratamiento en San Ángel CDMX',
      'primera consulta psiquiátrica en San Ángel CDMX',
      'valoración neuropsiquiátrica en San Ángel CDMX',
      'psiquiatra bilingüe San Ángel CDMX',
      'consulta de salud mental en San Ángel CDMX',
      'psicoterapia en San Ángel CDMX',
      'ataques de pánico tratamiento en San Ángel CDMX',
      'síntomas cognitivos valoración en San Ángel CDMX',
      'problemas de memoria valoración en San Ángel CDMX',
    ];
---

<footer class="bg-burgundy py-16 pb-7 text-cream">
  <div class="container-premium">
    <div class="grid gap-8 border-b border-cream/12 pb-9 md:grid-cols-[1.1fr_0.8fr_0.8fr]">
      <div>
        <a href={isHome ? '#inicio' : homeHref} class="mb-5 inline-flex" aria-label={`${doctorProfile.brandName} inicio`}>
          <picture>
            <source srcset="/neuro-diversa-logo-light.webp" type="image/webp" />
            <img
              class="h-auto w-[190px] max-w-full object-contain sm:w-[220px]"
              src="/neuro-diversa-logo-light.png"
              alt="Neuro Diversa"
              width="863"
              height="399"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </a>
        <p class="mb-5 max-w-sm text-sm text-cream/62">
          {isEnglish ? 'Psychiatry · Psychology · Neurodiversity' : 'Psiquiatría · Psicología · Neurodiversidad'}<br />
          {doctorProfile.location}
        </p>
        <a class="btn btn-primary" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">{ui.book}</a>
      </div>
      <div>
        <h4 class="mb-3 font-semibold">{ui.footerNav}</h4>
        {navItems.slice(1).map((item) => <a class="my-2 block text-cream/62 hover:text-cream" href={navigationHref(item.href)}>{item.label}</a>)}
        <a class="my-2 block text-cream/62 hover:text-cream" href={ui.privacyHref}>{ui.footerPrivacy}</a>
      </div>
      <div>
        <h4 class="mb-3 font-semibold">{ui.footerContact}</h4>
        <a class="my-2 block text-cream/62 hover:text-cream" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">Doctoralia</a>
        <a class="my-2 block text-cream/62 hover:text-cream" href={doctorProfile.phoneHref}>{doctorProfile.phoneLabel}</a>
        <a class="my-2 block text-cream/62 hover:text-cream" href={doctorProfile.secondaryPhoneHref}>{doctorProfile.secondaryPhoneLabel}</a>
      </div>
    </div>
    <div class="pt-5 text-xs text-cream/42">
      {ui.footerDisclaimer}
    </div>
    <div class="mt-8 border-t border-cream/10 pt-6 text-center text-[11px] font-semibold leading-7 text-cream/34">
      {footerKeywords.map((keyword, index) => (
        <>
          <span>{keyword}</span>
          {index < footerKeywords.length - 1 && <span class="px-2 text-cream/18">·</span>}
        </>
      ))}
    </div>
  </div>
</footer>
