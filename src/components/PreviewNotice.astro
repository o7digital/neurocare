---
const en = Astro.url.pathname.startsWith("/en");
---

<aside
  class="preview-notice"
  aria-label={en ? "Website proposal" : "Propuesta del sitio"}
>
  <div class="container-premium flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-2">
    <p>
      <strong>◌ {en ? "Design preview" : "Propuesta de evolución"}</strong>
      <span class="hidden sm:inline">
        {" "}
        ·{" "}
        {en
          ? "Illustrative content, pending approval"
          : "Contenido ilustrativo, pendiente de validación"}
      </span>
    </p>
    <a href="/admin/">
      {en ? "Explore editorial workspace" : "Explorar espacio editorial"} ↗
    </a>
  </div>
</aside>
<style>
  .preview-notice {
    background: #efe8ee;
    color: #564451;
    font-size: 11px;
    letter-spacing: 0.015em;
  }
  .preview-notice a {
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 700;
  }
</style>
