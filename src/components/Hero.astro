---
import { doctorProfile } from "../data/site";
const en = Astro.url.pathname.startsWith("/en");
const program = en
  ? "/en/programs/social-skills/"
  : "/programas/habilidades-sociales/";
---

<section id="inicio" class="collective-hero">
  <div class="container-premium">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">
          {en
            ? "Psychiatry + Psychology · San Ángel, Mexico City"
            : "Psiquiatría + Psicología · San Ángel, CDMX"}
        </span>
        <h1>
          {en ? "Different ways" : "Distintas formas"}
          <br />
          {en ? "of being." : "de ser."}
          <br />
          <em>{en ? "A place to connect." : "Un espacio para conectar."}</em>
        </h1>
        <p class="lead">
          {en
            ? "Individual care and shared experiences. A space to understand yourself, care for your mental health and explore your connections, at your own pace."
            : "Atención individual y experiencias compartidas. Un espacio para comprenderte, cuidar tu salud mental y explorar tus vínculos, a tu propio ritmo."}
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#equipo">
            {en ? "Meet our team" : "Conoce al equipo"} ↗
          </a>
          <a class="hero-text-link" href={program}>
            {en ? "Explore our group program" : "Descubre el programa grupal"} →
          </a>
        </div>
        <p class="hero-location">
          ◌{" "}
          {en
            ? "Adults · In-person and online care"
            : "Personas adultas · Atención presencial y en línea"}
        </p>
      </div>
      <div class="hero-composition">
        <div class="hero-arch">
          <picture>
            <source srcset={doctorProfile.avatarWebp} type="image/webp" />
            <img
              src={doctorProfile.avatar}
              alt={doctorProfile.fullName}
              width="900"
              height="900"
              fetchpriority="high"
            />
          </picture>
          <div class="hero-doctor">
            <span>
              {en
                ? "Meet our psychiatrist"
                : "Nuestra especialista en psiquiatría"}
            </span>
            <strong>Dra. Ariadna Mondragón</strong>
          </div>
        </div>
        <div class="connection-note">
          <div class="connection-art" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </div>
          <p>
            {en ? "Being yourself." : "Ser tú."}
            <br />
            <em>{en ? "Connecting with others." : "Conectar con otros."}</em>
          </p>
          <span>
            {en ? "That is where we begin." : "Desde ahí comenzamos."}
          </span>
        </div>
        <a class="hero-group-tag" href={program}>
          <span class="tag-dot" aria-hidden="true"></span>
          <span>
            {en ? "New group project" : "Nuevo proyecto grupal"}
            <strong>
              {en
                ? "Social skills · January 2027*"
                : "Habilidades sociales · Enero 2027*"}
            </strong>
          </span>
          <b aria-hidden="true">↗</b>
        </a>
      </div>
    </div>
    <div class="hero-services">
      <span>
        {en
          ? "Care that meets you where you are"
          : "Acompañamiento desde distintas miradas"}
      </span>
      <a href="#la-doctora">
        {en ? "Psychiatry & neuropsychiatry" : "Psiquiatría y neuropsiquiatría"}{" "}
        ↗
      </a>
      <a href="#seguimiento-psicologico">
        {en ? "Psychological support" : "Acompañamiento psicológico"} ↗
      </a>
      <a href={program}>
        {en ? "Group experiences" : "Experiencias grupales"} ↗
      </a>
    </div>
  </div>
</section>
<style>
  .collective-hero {
    padding: 64px 0 0;
    background: radial-gradient(ellipse at 90% 10%, #f0e6ed88, transparent 55%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.08fr 1fr;
    align-items: center;
    gap: 50px;
  }
  h1 {
    font-family: Georgia, serif;
    font-size: clamp(44px, 4.6vw, 66px);
    line-height: 1.06;
    margin: 26px 0;
    letter-spacing: -0.035em;
  }
  h1 em {
    color: var(--color-wine);
    font-weight: 400;
  }
  .hero-copy .eyebrow {
    font-size: 10px;
    letter-spacing: 0.065em;
  }
  .hero-copy .lead {
    font-size: 17px;
    max-width: 495px;
    line-height: 1.8;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
    margin-top: 30px;
  }
  .hero-text-link {
    font-size: 13px;
    font-weight: 700;
    border-bottom: 1px solid var(--color-sand);
    padding: 9px 0;
  }
  .hero-location {
    font-size: 11px;
    color: var(--color-muted);
    margin-top: 24px;
  }
  .hero-composition {
    position: relative;
    min-height: 510px;
    padding: 0 0 65px 30px;
  }
  .hero-arch {
    position: relative;
    width: 82%;
    height: 438px;
    margin-left: auto;
    overflow: hidden;
    border-radius: 160px 160px 18px 18px;
    background: #e5d5ce;
  }
  .hero-arch picture,
  .hero-arch img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-arch img {
    object-position: center 35%;
  }
  .hero-doctor {
    text-align: right;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 65px 22px 22px;
    background: linear-gradient(transparent, #35212bba);
    color: white;
  }
  .hero-doctor span {
    max-width: 180px;
    margin-left: auto;
    display: block;
    font-size: 10px;
    margin-bottom: 4px;
  }
  .hero-doctor strong {
    display: block;
    max-width: 205px;
    margin-left: auto;
    font-size: 17px;
  }
  .connection-note {
    position: absolute;
    left: -4px;
    top: 210px;
    padding: 24px;
    width: 195px;
    min-height: 198px;
    background: #e4dce8;
    border: 6px solid var(--color-cream);
    border-radius: 80px 80px 12px 12px;
    transform: rotate(-5deg);
    box-shadow: 0 15px 45px #402b3510;
    text-align: center;
  }
  .connection-note p {
    font-family: Georgia, serif;
    font-size: 20px;
    line-height: 1.25;
    margin: 10px -8px 6px;
    color: #60445e;
  }
  .connection-note > span {
    font-size: 9px;
    color: #786878;
  }
  .connection-art {
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }
  .connection-art i {
    display: block;
    height: 35px;
    width: 35px;
    border: 1px solid #9a7b96;
    border-radius: 50%;
    margin-left: -9px;
  }
  .connection-art i:nth-child(2) {
    background: #c6afc433;
    transform: translateY(-8px);
  }
  .hero-group-tag {
    position: absolute;
    bottom: 12px;
    left: 60px;
    right: 0;
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 18px;
    border: 1px solid var(--color-sand);
    background: var(--color-paper);
    border-radius: 10px;
    box-shadow: 0 15px 40px #402b3508;
  }
  .hero-group-tag span {
    font-size: 10px;
    color: var(--color-muted);
  }
  .hero-group-tag strong {
    display: block;
    color: var(--color-text);
    font-size: 12px;
    margin-top: 4px;
  }
  .hero-group-tag b {
    margin-left: auto;
    color: var(--color-wine);
    font-size: 22px;
  }
  .tag-dot {
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #9fa58e;
    box-shadow: 0 0 0 6px #e7eadf;
    margin: 0 4px;
    flex-shrink: 0;
  }
  .hero-services {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 55px;
    padding: 28px 0;
    border-top: 1px solid var(--color-sand);
    border-bottom: 1px solid var(--color-sand);
    font-size: 12px;
  }
  .hero-services > span {
    color: var(--color-muted);
    font-size: 10px;
  }
  .hero-services a {
    font-weight: 700;
    color: var(--color-coffee);
  }
  @media (max-width: 900px) {
    .hero-grid {
      gap: 24px;
    }
    .hero-composition {
      padding-left: 0;
    }
    .connection-note {
      left: -10px;
      width: 165px;
    }
    .hero-group-tag {
      left: 0;
    }
    h1 {
      font-size: 49px;
    }
  }
  @media (max-width: 700px) {
    .collective-hero {
      padding-top: 36px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    h1 {
      font-size: clamp(42px, 10.8vw, 64px);
    }
    .hero-composition {
      width: 100%;
      max-width: 460px;
      margin: auto;
      min-height: 475px;
    }
    .hero-arch {
      height: 400px;
    }
    .hero-doctor strong {
      max-width: 155px;
      font-size: 15px;
    }
    .hero-doctor span {
      max-width: 155px;
    }
    .connection-note {
      left: 0;
      top: 180px;
    }
    .hero-services {
      margin-top: 25px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
