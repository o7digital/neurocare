---
import { doctorProfile, trustItems } from '../data/site';
---

<section id="inicio" class="relative overflow-hidden py-16 md:py-24">
  <div class="absolute left-[48%] top-20 hidden h-[620px] w-[620px] rounded-full border border-teal/10 lg:block"></div>
  <div class="container-premium grid items-center gap-14 lg:grid-cols-[1fr_0.92fr]">
    <div class="reveal show">
      <div class="mb-6 inline-flex items-center gap-3 rounded-full border border-line bg-white/70 px-3.5 py-2 text-[13px] font-extrabold text-[#42556c] shadow-[0_12px_30px_rgb(7_26_47_/_0.06)]">
        <span class="signal-dot"></span> Consulta privada de psiquiatria · <b class="text-teal">San Angel, CDMX</b>
      </div>
      <h1 class="mb-7 max-w-4xl text-[46px] font-black leading-[0.96] text-ink sm:text-[64px] lg:text-[82px]">
        Psiquiatria con ciencia, escucha y claridad.
      </h1>
      <p class="mb-9 max-w-2xl text-lg text-muted md:text-xl">
        Atencion psiquiatrica personalizada en un espacio privado, respetuoso y sin juicios. Un acompanamiento medico pensado para comprender lo que estas viviendo y construir un tratamiento adecuado para ti.
      </p>
      <div class="mb-8 flex flex-wrap gap-3.5">
        <a class="btn btn-primary" href={doctorProfile.doctoraliaUrl}>Agendar una consulta</a>
        <a class="btn btn-secondary" href="#sobre-mi">Conocer a la doctora</a>
      </div>
      <div class="flex max-w-2xl flex-wrap gap-2.5">
        {['Atencion personalizada', 'Consulta privada', 'San Angel, CDMX', doctorProfile.onlineCareNote].map((item) => (
          <span class="rounded-full border border-line bg-white/68 px-3.5 py-2 text-xs font-black uppercase tracking-[0.08em] text-muted">{item}</span>
        ))}
      </div>
    </div>

    <div class="reveal show relative min-h-[620px] max-lg:min-h-[560px] max-sm:min-h-[520px]">
      <div class="absolute inset-0 rounded-[48px] bg-[radial-gradient(circle_at_72%_22%,rgb(88_209_201_/_0.35),transparent_210px),linear-gradient(145deg,#071a2f,#0d2c4e_58%,#0b8b89)] shadow-premium"></div>
      <div class="absolute inset-6 rounded-[42px] border border-white/18"></div>
      <div class="orbital-lines absolute inset-8"></div>
      <div class="doctor-portrait absolute bottom-0 left-1/2 h-[78%] w-[72%] -translate-x-1/2"></div>
      <div class="absolute left-5 top-7 rounded-[26px] border border-white/16 bg-white/12 p-4 text-white shadow-[0_20px_60px_rgb(0_0_0_/_0.18)] backdrop-blur-xl sm:left-8 sm:p-5">
        <b class="block text-lg">{doctorProfile.fullName}</b>
        <span class="block text-sm text-white/72">{doctorProfile.specialty}</span>
        <span class="mt-2 block text-xs font-bold text-champagne">{doctorProfile.license}</span>
      </div>
      <div class="absolute bottom-8 right-5 rounded-[24px] border border-white/18 bg-white/92 p-4 text-ink shadow-soft sm:right-8">
        <b class="block">Consulta privada</b>
        <span class="text-sm font-bold text-muted">San Angel · CDMX</span>
      </div>
    </div>
  </div>
</section>

<section aria-label="Confianza profesional" class="border-y border-line/70 bg-white/58 py-5">
  <div class="container-premium flex flex-wrap justify-center gap-3">
    {trustItems.map((item) => (
      <span class="rounded-full bg-[#effaf8] px-4 py-2 text-xs font-black uppercase tracking-[0.1em] text-teal">{item}</span>
    ))}
  </div>
</section>
