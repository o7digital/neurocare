---
// UI adapted from o7digital/suitesmine-bot/components/O7Widget.jsx, 140c1d1.
const en = Astro.url.pathname.startsWith('/en');
---
<div id="neurodiversa-olivia" data-language={en ? 'en' : 'es'}>
  <section class="olivia-panel" hidden role="dialog" aria-label="Olivia AI">
    <header class="olivia-header"><span class="olivia-mark" aria-hidden="true">✧</span><div><h2>Olivia AI</h2><p class="olivia-presence"><i class="presence-dot"></i><span data-presence></span></p></div><button type="button" data-close aria-label={en?'Close chat':'Cerrar chat'}>×</button></header>
    <div class="olivia-scroll">
      <p class="olivia-context">NEURO DIVERSA · SAN ÁNGEL</p>
      <div class="olivia-messages" role="log" aria-live="polite"></div>
      <div class="olivia-actions"><button type="button" data-interest="group">{en?'Social skills group':'Grupo de habilidades sociales'}</button><button type="button" data-interest="psychology">{en?'Psychological support':'Atención psicológica'}</button><button type="button" data-interest="psychiatry">{en?'Psychiatry':'Psiquiatría'}</button></div>
      <form class="olivia-lead" hidden>
        <h3>{en?'Let us contact you':'Queremos escucharte'}</h3><p>{en?'The team will contact you to confirm details.':'El equipo recibirá tu solicitud y te contactará para confirmar los detalles.'}</p>
        <div class="olivia-fields"><label>{en?'First name':'Nombre'}<input required name="firstName" autocomplete="given-name" maxlength="100" /></label><label>{en?'Last name':'Apellido'}<input required name="lastName" autocomplete="family-name" maxlength="100" /></label></div>
        <label>Email<input required type="email" name="email" autocomplete="email" maxlength="240" /></label><label>{en?'Phone':'Teléfono'}<input required type="tel" name="phone" autocomplete="tel" minlength="6" maxlength="40" /></label>
        <label>{en?'I am interested in':'Me interesa'}<select name="interest"><option value="group">{en?'Social skills group':'Grupo de habilidades sociales'}</option><option value="psychology">{en?'Psychological support':'Atención psicológica'}</option><option value="psychiatry">{en?'Psychiatry':'Psiquiatría'}</option><option value="general">{en?'General information':'Información general'}</option></select></label>
        <label>{en?'Your request':'Tu solicitud'}<textarea required name="message" rows="3" maxlength="3000"></textarea></label>
        <label class="olivia-check"><input required type="checkbox" name="consent" /><span>{en?'I authorize the team to use these details to respond to my request.':'Autorizo al equipo a usar estos datos para atender mi solicitud.'} <a href={en?'/en/privacy-notice/':'/aviso-de-privacidad/'} target="_blank" rel="noreferrer">{en?'Privacy notice':'Aviso de privacidad'}</a></span></label>
        <label class="olivia-check"><input type="checkbox" name="marketingConsent" /><span>{en?'Send me news and newsletters too (optional).':'También quiero recibir novedades y boletines (opcional).'}</span></label>
        <button class="olivia-primary" type="submit">{en?'Send request':'Enviar solicitud'}</button>
      </form>
      <p class="olivia-feedback" role="status" aria-live="polite"></p>
    </div>
    <form class="olivia-composer"><label class="olivia-check"><input type="checkbox" name="chatConsent" /><span>{en?'I accept the use of my messages to receive assistance.':'Acepto el uso de mis mensajes para recibir orientación.'} <a href={en?'/en/privacy-notice/':'/aviso-de-privacidad/'}>{en?'Privacy':'Privacidad'}</a></span></label><div><input name="message" required maxlength="2500" aria-label={en?'Message':'Mensaje'} placeholder={en?'Ask Olivia…':'Escribe a Olivia…'} /><button type="submit" aria-label={en?'Send message':'Enviar mensaje'}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m4 4 17 8-17 8 3-8-3-8Zm3 8h14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></button></div></form>
    <footer class="olivia-footer">{en?'General information · Not an emergency service':'Orientación general · No es un servicio de urgencias'}</footer>
  </section>
  <button class="olivia-launcher" type="button" aria-expanded="false" aria-label={en?'Open Olivia AI':'Abrir Olivia AI'}><span class="launcher-icon" aria-hidden="true">✧</span><span>Olivia AI <small><i class="presence-dot"></i><span data-presence></span></small></span></button>
</div>
<script>import '../scripts/oliviaWidget';</script>
<style is:global>
  #neurodiversa-olivia{position:fixed;right:24px;bottom:24px;z-index:10000;font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#402b35;font-size:14px;line-height:1.5}#neurodiversa-olivia *{box-sizing:border-box}#neurodiversa-olivia [hidden]{display:none!important}#neurodiversa-olivia button{cursor:pointer;font:inherit}#neurodiversa-olivia button:disabled{opacity:.55;cursor:wait}#neurodiversa-olivia :focus-visible{outline:3px solid #c98f91;outline-offset:3px}
  .olivia-panel{display:flex;flex-direction:column;width:420px;max-width:calc(100vw - 32px);height:min(740px,calc(100dvh - 125px));margin-bottom:16px;overflow:hidden;border-radius:28px;border:1px solid #e6d6ce;background:#fffdf9;box-shadow:0 36px 78px -24px #20101666,0 12px 24px -14px #402b3555;animation:olivia-reveal .2s ease-out}.olivia-header{display:flex;align-items:center;gap:12px;background:#2b282b;color:white;padding:20px;border-bottom:2px solid #c8aa70}.olivia-mark{display:grid;place-items:center;width:43px;height:43px;background:#ffffff12;border:1px solid #ffffff29;border-radius:50%;color:#f4d99a;font-size:28px}.olivia-header h2{margin:0;font-size:18px;font-weight:650}.olivia-presence{display:flex;align-items:center;gap:8px;margin:5px 0 0;font-size:12px;color:#eee2d3}.presence-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:#f59e0b;box-shadow:0 0 0 4px #f59e0b1f}.olivia-online .presence-dot{background:#34d399;box-shadow:0 0 0 4px #34d3991f,0 0 12px #34d39955}.olivia-header [data-close]{margin-left:auto;background:#ffffff14;color:white;border:0;border-radius:50%;width:34px;height:34px;font-size:24px}
  .olivia-scroll{flex:1;min-height:0;overflow-y:auto;padding:18px;background:#f7f2ed;overscroll-behavior:contain}.olivia-context{margin:0 0 14px;text-align:center;font-size:10px;letter-spacing:.13em;color:#8d777b}.olivia-bubble{width:fit-content;max-width:92%;padding:12px 15px;margin:0 0 12px;border-radius:16px 16px 16px 4px;background:#fffdf9;border:1px solid #e7dcd3;white-space:pre-wrap;overflow-wrap:anywhere;font-size:14px}.olivia-bubble.visitor{margin-left:auto;background:#722f3b;color:white;border:0;border-radius:16px 16px 4px 16px}.olivia-bubble.operator::before{content:'Neuro Diversa';display:block;font-size:11px;font-weight:700;margin-bottom:5px;color:#87424d}.olivia-actions{display:flex;flex-wrap:wrap;gap:7px;margin:15px 0}.olivia-actions button{border:1px solid #dec9c8;background:#fffcf9;border-radius:20px;padding:8px 11px;color:#722f3b;font-size:12px!important}
  .olivia-lead{padding:16px;background:#fffdf9;border:1px solid #e5d5d0;border-radius:18px;display:grid;gap:10px}.olivia-lead h3{margin:0;font:23px Georgia,serif}.olivia-lead>p{margin:0;font-size:13px;color:#79636a}.olivia-lead label{display:grid;gap:4px;font-size:12px}.olivia-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}.olivia-lead input,.olivia-lead textarea,.olivia-lead select{width:100%;min-width:0;border:1px solid #dfceca;border-radius:9px;padding:10px;background:white;font:inherit;color:#402b35}.olivia-lead textarea{resize:vertical}.olivia-check{display:flex!important;align-items:flex-start;gap:8px!important;font-size:11px!important;color:#78636b;line-height:1.5}.olivia-check input{width:14px!important;height:14px;flex-shrink:0;margin-top:2px;accent-color:#722f3b}.olivia-check a{color:#722f3b;text-decoration:underline}.olivia-primary{border:0;border-radius:10px;padding:12px;background:#722f3b;color:white;font-weight:650!important}.olivia-feedback{font-size:13px;color:#722f3b;white-space:pre-wrap}.olivia-feedback:empty{display:none}.olivia-composer{padding:14px;background:#fffdf9;border-top:1px solid #eaded6}.olivia-composer>div{display:flex;gap:8px;margin-top:10px}.olivia-composer>div input{flex:1;min-width:0;border:1px solid #e2d4cc;background:white;border-radius:13px;padding:13px;font:inherit}.olivia-composer>div button{display:grid;place-items:center;flex-shrink:0;width:47px;background:#722f3b;color:white;border:0;border-radius:13px}.olivia-footer{text-align:center;padding:0 12px 12px;font-size:10px;color:#8b7980;background:#fffdf9}
  .olivia-launcher{display:flex;align-items:center;gap:13px;margin-left:auto;border:1px solid #ffffff44;border-radius:22px;padding:13px 19px 13px 12px;background:linear-gradient(145deg,#392e33,#201c21);color:white;box-shadow:0 16px 40px #35202d33;text-align:left}.launcher-icon{display:grid;place-items:center;width:42px;height:42px;background:#ffffff0f;border:1px solid #c8aa7077;color:#f4d99a;border-radius:50%;font-size:28px}.olivia-launcher>span:nth-child(2){font-size:15px;font-weight:650}.olivia-launcher small{display:flex;align-items:center;gap:7px;margin-top:4px;font-weight:400;font-size:11px;color:#eadfd5}.olivia-launcher .presence-dot{width:7px;height:7px}@keyframes olivia-reveal{from{opacity:0;transform:translateY(12px) scale(.98)}to{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){.olivia-panel{animation:none}}@media(max-width:560px){#neurodiversa-olivia{right:12px;bottom:76px}.olivia-panel{position:fixed;inset:10px 10px 80px;width:auto;max-width:none;height:auto;margin:0;border-radius:22px}.olivia-launcher{padding:10px 13px;border-radius:19px}.launcher-icon{width:34px;height:34px}.olivia-panel:not([hidden])~.olivia-launcher{visibility:hidden}}
</style>
