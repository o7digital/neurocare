---
import { getSiteContent } from '../data/site';

const { articles, ui } = getSiteContent(Astro.url.pathname);
---

<section id="articulos" class="section-premium bg-paper">
  <div class="container-premium">
    <span class="eyebrow">{ui.articlesEyebrow}</span>
    <h2 class="section-title">{ui.articlesTitle}</h2>
    <p class="lead">
      {ui.articlesLead}
    </p>
    <div class="mt-12 divide-y divide-sand border-y border-sand">
      {articles.map(([category, title, href]) => (
        <a class="reveal group grid gap-3 py-6 transition hover:bg-beige/45 md:grid-cols-[180px_1fr_44px] md:items-center" href={href} aria-label={`${ui.knowMore}: ${title}`}>
          <span class="text-sm font-bold text-camel">{category}</span>
          <h3 class="text-2xl font-semibold text-text transition group-hover:text-wine">{title}</h3>
          <span class="grid h-10 w-10 place-items-center rounded-[8px] border border-sand text-2xl font-semibold leading-none text-wine transition group-hover:border-wine group-hover:bg-wine group-hover:text-white" aria-hidden="true">+</span>
        </a>
      ))}
    </div>
  </div>
</section>
