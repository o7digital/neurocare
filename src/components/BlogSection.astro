---
import { articlePages, englishArticlePages, getSiteContent } from '../data/site';

const { ui } = getSiteContent(Astro.url.pathname);
const isEnglish = Astro.url.pathname.startsWith('/en');
const articles = isEnglish ? englishArticlePages : articlePages;
const blogHref = isEnglish ? '/en/blog/' : '/blog/';
---

<section id="articulos" class="section-premium bg-paper">
  <div class="container-premium">
    <span class="eyebrow">{ui.articlesEyebrow}</span>
    <h2 class="section-title">{ui.articlesTitle}</h2>
    <p class="lead">
      {ui.articlesLead}
    </p>
    <div class="mt-12 divide-y divide-sand border-y border-sand">
      {articles.map(({ category, title, description, sections, href }) => (
        <details class="reveal group">
          <summary class="grid cursor-pointer list-none gap-3 py-6 transition hover:bg-beige/45 md:grid-cols-[44px_180px_1fr] md:items-center">
            <span class="grid h-10 w-10 place-items-center rounded-[8px] border border-sand text-2xl font-semibold leading-none text-wine transition group-open:border-wine group-open:bg-wine group-open:text-white" aria-hidden="true">
              <span class="group-open:hidden">+</span>
              <span class="hidden group-open:block">-</span>
            </span>
            <span class="text-sm font-bold text-camel">{category}</span>
            <h3 class="text-2xl font-semibold text-text transition group-open:text-wine">{title}</h3>
          </summary>
          <div class="pb-8 pl-0 text-muted md:pl-[224px]">
            <p class="max-w-3xl text-lg leading-8">{description}</p>
            <div class="mt-6 grid gap-5">
              {sections.map(([heading, body]) => (
                <section class="max-w-3xl">
                  <h4 class="mb-2 text-lg font-semibold text-text">{heading}</h4>
                  <p class="leading-7">{body}</p>
                </section>
              ))}
            </div>
            <a class="btn btn-secondary mt-7" href={href}>{isEnglish ? 'Read the full article' : 'Leer el artículo completo'}</a>
          </div>
        </details>
      ))}
    </div>
    <div class="mt-10 flex justify-center">
      <a class="btn btn-primary" href={blogHref}>{isEnglish ? 'View the blog' : 'Ver todo el blog'}</a>
    </div>
  </div>
</section>
