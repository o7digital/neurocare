---
import { articles } from '../data/site';
---

<section id="articulos" class="section-premium bg-paper">
  <div class="container-premium">
    <span class="eyebrow">Articulos</span>
    <h2 class="section-title">Lecturas para comprender mejor antes de consultar.</h2>
    <p class="lead">
      Temas editoriales preparados para publicarse con revision medica, sin sustituir una valoracion individual.
    </p>
    <div class="mt-12 divide-y divide-sand border-y border-sand">
      {articles.map(([category, title]) => (
        <article class="reveal grid gap-3 py-6 md:grid-cols-[180px_1fr_auto] md:items-center">
          <span class="text-sm font-bold text-camel">{category}</span>
          <h3 class="text-2xl font-semibold text-text">{title}</h3>
          <a class="font-black text-wine" href="#agenda">Agendar consulta</a>
        </article>
      ))}
    </div>
  </div>
</section>
