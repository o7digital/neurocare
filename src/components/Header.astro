---
import { getSiteContent } from '../data/site';

const { doctorProfile, navItems, ui } = getSiteContent(Astro.url.pathname);
const isEnglish = Astro.url.pathname.startsWith('/en');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en/';
const homeHref = isEnglish ? '/en/' : '/';
const languageHref = Astro.url.pathname.startsWith('/en/privacy-notice')
  ? '/aviso-de-privacidad/'
  : Astro.url.pathname.startsWith('/aviso-de-privacidad')
    ? '/en/privacy-notice/'
    : ui.languageHref;
const sectionHref = (href: string) => isHome ? href : `${homeHref}${href}`;
---

<header class="sticky top-0 z-50 border-b border-sand/80 bg-paper/88 backdrop-blur-2xl">
  <nav class="container-premium flex h-[88px] items-center justify-between gap-5">
    <a href={isHome ? '#inicio' : homeHref} class="flex min-w-0 items-center" aria-label={`${doctorProfile.brandName} inicio`}>
      <picture>
        <source srcset="/neuro-diversa-logo.webp" type="image/webp" />
        <img
          class="h-[60px] w-auto max-w-[200px] object-contain sm:h-[70px] sm:max-w-[238px]"
          src="/neuro-diversa-logo.png"
          alt="Neuro Diversa"
          width="863"
          height="399"
          loading="eager"
          decoding="async"
        />
      </picture>
    </a>

    <div class="hidden items-center gap-5 text-[16px] font-bold text-coffee xl:flex">
      {navItems.map((item) => <a class="transition hover:text-wine" href={sectionHref(item.href)}>{item.label}</a>)}
    </div>

    <div class="flex items-center gap-3">
      <a class="rounded-[8px] border border-sand px-3 py-2 text-[16px] font-bold text-coffee transition hover:bg-beige hover:text-wine" href={languageHref}>{ui.languageLabel}</a>
      <a class="btn btn-primary hidden sm:inline-flex" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">{ui.book}</a>
      <button
        class="js-mobile-menu-toggle grid h-11 w-11 place-items-center rounded-[8px] border border-sand bg-paper text-espresso shadow-[0_10px_24px_rgb(74_48_50_/_0.08)] xl:hidden"
        type="button"
        aria-label={ui.menuLabel}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="grid w-5 gap-1.5" aria-hidden="true">
          <span class="mobile-menu-line h-0.5 rounded-full bg-espresso transition"></span>
          <span class="mobile-menu-line h-0.5 rounded-full bg-espresso transition"></span>
          <span class="mobile-menu-line h-0.5 rounded-full bg-espresso transition"></span>
        </span>
      </button>
    </div>
  </nav>
  <div id="mobile-menu" class="hidden border-t border-sand/80 bg-paper/98 xl:hidden">
    <div class="container-premium grid gap-2 py-4">
      {navItems.map((item) => <a class="js-mobile-menu-link rounded-[8px] px-4 py-3 text-[18px] font-bold text-coffee transition hover:bg-beige hover:text-wine" href={sectionHref(item.href)}>{item.label}</a>)}
      <a class="btn btn-primary js-mobile-menu-link mt-2 w-full" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">{ui.book}</a>
    </div>
  </div>
</header>
