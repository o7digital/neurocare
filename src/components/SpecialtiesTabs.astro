---
import { careAreas, doctorProfile } from '../data/site';
---

<section id="areas" class="section-premium relative overflow-hidden bg-navy text-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_16%_10%,rgb(227_201_142_/_0.16),transparent_340px),radial-gradient(circle_at_86%_50%,rgb(88_209_201_/_0.16),transparent_360px)]"></div>
  <div class="container-premium">
    <span class="eyebrow">Como puedo ayudarte</span>
    <h2 class="section-title section-title-light">Areas de atencion psiquiatrica.</h2>
    <p class="lead text-white/70">
      Consulta privada para comprender lo que estas viviendo, valorar opciones medicas y definir un acompanamiento claro y responsable.
    </p>
    <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {careAreas.map((area) => (
        <article class="reveal rounded-[34px] border border-white/14 bg-white/[0.075] p-6 shadow-[0_28px_70px_rgb(0_0_0_/_0.22)] backdrop-blur-xl">
          <div class={`area-icon area-icon-${area.icon} mb-7`}></div>
          <h3 class="mb-3 text-2xl font-black leading-tight">{area.title}</h3>
          <p class="mb-6 text-white/68">{area.description}</p>
          <div class="flex flex-wrap gap-3">
            <a class="font-black text-champagne" href="#articulos">Conocer mas</a>
            <a class="font-black text-teal-soft" href={doctorProfile.doctoraliaUrl}>Agendar consulta</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
