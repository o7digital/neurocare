---
import { consultationReasons, doctorProfile } from '../data/site';
---

<section id="motivos" class="section-premium">
  <div class="container-premium">
    <span class="eyebrow">Motivos de consulta</span>
    <h2 class="section-title">En que puedo ayudarte.</h2>
    <p class="lead">
      Cada situacion requiere una valoracion individual. Estos son algunos de los motivos de consulta que atiendo con mayor frecuencia.
    </p>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {consultationReasons.map((reason, index) => (
        <article class:list={[
          'reveal relative overflow-hidden rounded-[28px] border p-6',
          index === 0 ? 'border-burgundy bg-burgundy text-cream' : 'border-sand bg-paper text-text shadow-soft',
        ]}>
          <span class:list={['number-bg', index === 0 ? '!text-cream/10' : '']}>{String(index + 1).padStart(2, '0')}</span>
          <div class:list={['mb-5 h-px w-16', index === 0 ? 'bg-cream/45' : 'bg-wine/45']}></div>
          <h3 class="relative mb-3 text-2xl font-semibold leading-tight">{reason.title}</h3>
          <p class:list={['relative mb-5 text-sm', index === 0 ? 'text-cream/78' : 'text-muted']}>{reason.description}</p>
          <ul class="relative mb-6 grid gap-2 text-sm font-bold">
            {reason.items.map((item) => <li class={index === 0 ? 'text-cream/88' : 'text-coffee'}>{item}</li>)}
          </ul>
          <div class="relative flex flex-wrap gap-3">
            <a class={index === 0 ? 'font-black text-cream' : 'font-black text-wine'} href={reason.href}>Conocer mas</a>
            <a class={index === 0 ? 'font-black text-sand' : 'font-black text-coffee'} href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">Agendar consulta</a>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-8 max-w-3xl text-sm font-bold text-muted">
      La informacion de esta pagina es orientativa. Cada diagnostico requiere una valoracion medica individual.
    </p>
  </div>
</section>
