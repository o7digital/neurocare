---
import { getSiteContent } from '../data/site';

const { consultationReasons, psychologicalCare, doctorProfile, ui } = getSiteContent(Astro.url.pathname);
---

<section id="motivos" class="section-premium">
  <div class="container-premium">
    <span class="eyebrow">{ui.reasonsEyebrow}</span>
    <h2 class="section-title">{ui.reasonsTitle}</h2>
    <p class="lead">
      {ui.reasonsLead}
    </p>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {consultationReasons.map((reason, index) => (
        <article class:list={[
          'reveal relative overflow-hidden rounded-[8px] border p-6',
          index === 0 ? 'border-water/30 bg-[linear-gradient(135deg,#fffdf9,#f4ebe6_48%,#eef6f4)] text-text shadow-soft' : 'border-sand bg-paper text-text shadow-soft',
        ]}>
          <span class="number-bg">{String(index + 1).padStart(2, '0')}</span>
          <div class:list={['mb-5 h-px w-16', index === 0 ? 'bg-water/65' : 'bg-wine/35']}></div>
          <h3 class="relative mb-3 text-2xl font-semibold leading-tight">{reason.title}</h3>
          <p class="relative mb-5 text-sm text-muted">{reason.description}</p>
          <ul class="relative mb-6 grid gap-2 text-sm font-bold">
            {reason.items.map((item) => <li class="text-coffee">{item}</li>)}
          </ul>
          <div class="relative flex flex-wrap gap-3">
            <a class="font-black text-wine" href={reason.href}>{ui.knowMore}</a>
            <a class="font-black text-coffee" href={doctorProfile.doctoraliaUrl} target="_blank" rel="noreferrer">{ui.book}</a>
          </div>
        </article>
      ))}
      <article
        id="seguimiento-psicologico"
        class="reveal relative overflow-hidden rounded-[8px] border border-water/30 bg-[linear-gradient(135deg,#fffdf9,#f4ebe6_48%,#eef6f4)] p-6 text-text shadow-soft md:col-span-2 lg:col-span-3 lg:p-8"
      >
        <span class="number-bg">{String(consultationReasons.length + 1).padStart(2, '0')}</span>
        <div class="relative grid gap-6 lg:grid-cols-2 lg:gap-10">
          <div>
            <p class="mb-4 text-sm font-bold text-wine">{psychologicalCare.eyebrow}</p>
            <h3 class="mb-4 text-3xl font-semibold leading-tight">{psychologicalCare.title}</h3>
            <p class="text-muted">{psychologicalCare.description}</p>
            <a class="mt-6 inline-block font-black text-wine" href="#la-psicologa">
              {psychologicalCare.profileLink} ↗
            </a>
          </div>
          <div>
            <ul class="grid gap-3 text-sm font-bold text-coffee">
              {psychologicalCare.items.map((item) => (
                <li class="border-b border-sand pb-3">{item}</li>
              ))}
            </ul>
            <p class="mt-4 text-sm text-muted">{psychologicalCare.approach}</p>
          </div>
        </div>
      </article>
    </div>

    <p class="mt-8 max-w-3xl text-sm font-bold text-muted">
      {ui.reasonsDisclaimer}
    </p>
  </div>
</section>
