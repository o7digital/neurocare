---
import { doctorProfile, timeline } from "../data/site";
const en = Astro.url.pathname.startsWith("/en");
---

<section id="equipo" class="section-premium bg-paper">
  <div class="container-premium">
    <div class="team-intro">
      <div>
        <span class="eyebrow">
          {en
            ? "The people behind Neuro Diversa"
            : "Las personas detrás de Neuro Diversa"}
        </span>
        <h2 class="section-title">
          {en ? "Two perspectives." : "Dos miradas."}
          <br />
          <em class="text-wine">
            {en ? "One shared purpose." : "Un mismo propósito."}
          </em>
        </h2>
      </div>
      <p class="lead">
        {en
          ? "A shared space for psychiatry and psychology, with respect for each person’s story and way of experiencing the world."
          : "Un espacio que reúne psiquiatría y psicología, con respeto por la historia y la forma de vivir el mundo de cada persona."}
      </p>
    </div>
    <div class="team-grid">
      <article id="la-doctora" class="team-person">
        <div class="team-image">
          <picture>
            <source srcset={doctorProfile.portraitWebp} type="image/webp" />
            <img
              src={doctorProfile.portrait}
              alt={doctorProfile.fullName}
              width="640"
              height="640"
              loading="lazy"
            />
          </picture>
          <span class="team-number">
            01 / {en ? "Psychiatry" : "Psiquiatría"}
          </span>
        </div>
        <div class="team-person-copy">
          <p class="eyebrow">
            {en
              ? "Psychiatry · Neuropsychiatry"
              : "Psiquiatría · Neuropsiquiatría"}
          </p>
          <h3>
            Dra. Ariadna
            <br />
            Mondragón
          </h3>
          <p>
            {en
              ? "An integrated view of emotional, cognitive and neurological symptoms. Individual assessment and personalized medical care for adults."
              : "Una mirada integral a los síntomas emocionales, cognitivos y neurológicos. Valoración individual y atención médica personalizada para adultos."}
          </p>
          <details class="team-bio">
            <summary>
              {en
                ? "Background and professional details"
                : "Trayectoria y datos profesionales"}{" "}
              <span aria-hidden="true">+</span>
            </summary>
            <div>
              <p>{doctorProfile.fullName}</p>
              {timeline.map((item) => (
                <p>
                  <strong>{item.title}</strong>
                  <br />
                  {item.institution} · {item.year}
                </p>
              ))}
              <p>{doctorProfile.license}</p>
            </div>
          </details>
          <a
            class="team-link"
            href={doctorProfile.doctoraliaUrl}
            target="_blank"
            rel="noreferrer"
          >
            {en ? "Book with Dr. Ariadna" : "Agendar con la Dra. Ariadna"} ↗
          </a>
        </div>
      </article>
      <article class="team-person">
        <div class="team-image team-placeholder">
          <div class="portrait-placeholder" aria-hidden="true">
            <div></div>
            <span></span>
          </div>
          <p>
            {en
              ? "A new perspective joins the team"
              : "Una nueva mirada se suma al equipo"}
          </p>
          <span class="team-number">
            02 / {en ? "Psychology" : "Psicología"}
          </span>
        </div>
        <div class="team-person-copy">
          <p class="eyebrow">
            {en
              ? "Psychology · Neurodiversity"
              : "Psicología · Neurodiversidad"}
          </p>
          <h3>
            {en ? "Our psychology" : "Nuestra profesional"}
            <br />
            {en ? "professional" : "de psicología"}
          </h3>
          <p>
            {en
              ? "A place for the collaborating psychologist and the shared project around neurodiversity, social connection and group interventions."
              : "Un lugar para presentar a la psicóloga colaboradora y el proyecto compartido sobre neurodiversidad, vínculos e intervenciones grupales."}
          </p>
          <p class="profile-pending">
            {en
              ? "Preview profile. Name, photo, qualifications and biography to be supplied."
              : "Perfil de muestra. Nombre, fotografía, cédula y semblanza por integrar."}
          </p>
          <a
            class="team-link"
            href={
              en
                ? "/en/programs/social-skills/"
                : "/programas/habilidades-sociales/"
            }
          >
            {en
              ? "Discover the shared project"
              : "Conocer el proyecto conjunto"}{" "}
            ↗
          </a>
        </div>
      </article>
    </div>
    <p class="team-footnote">
      {en
        ? "Individual care and group activities, with a clear role for each professional."
        : "Atención individual y actividades grupales, con una función clara para cada profesional."}
    </p>
  </div>
</section>
<style>
  .team-intro {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 60px;
    align-items: center;
    margin-bottom: 48px;
  }
  .team-intro .section-title {
    font-size: clamp(36px, 4vw, 56px);
  }
  .team-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .team-person {
    border: 1px solid var(--color-sand);
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-cream);
  }
  .team-image {
    height: 340px;
    position: relative;
    overflow: hidden;
    background: #e8dbd5;
  }
  .team-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .team-image picture {
    display: block;
    height: 100%;
  }
  .team-number {
    position: absolute;
    bottom: 20px;
    left: 24px;
    padding: 7px 13px;
    background: var(--color-paper);
    border-radius: 5px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .team-person-copy {
    padding: 32px;
  }
  .team-person-copy h3 {
    font-family: Georgia, serif;
    font-size: 36px;
    line-height: 1.12;
    margin: 15px 0;
  }
  .team-person-copy > p:not(.eyebrow) {
    color: var(--color-muted);
  }
  .team-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse at 50% 80%, #d7ced8, transparent 65%), #eae4eb;
  }
  .team-placeholder > p {
    font-family: Georgia, serif;
    color: #655367;
    font-style: italic;
    font-size: 19px;
    margin-top: 14px;
  }
  .portrait-placeholder {
    position: relative;
    width: 150px;
    height: 160px;
    overflow: hidden;
  }
  .portrait-placeholder div {
    position: absolute;
    top: 4px;
    left: 45px;
    width: 60px;
    height: 70px;
    border: 1px solid #a48e9c;
    border-radius: 50%;
    background: #e6dce5;
  }
  .portrait-placeholder span {
    position: absolute;
    left: 4px;
    bottom: -50px;
    width: 142px;
    height: 120px;
    border: 1px solid #a48e9c;
    border-radius: 50%;
    background: #ded1df;
  }
  .profile-pending {
    margin-top: 20px;
    padding: 12px 14px;
    border-left: 2px solid #b297b1;
    font-size: 12px;
    background: #eee6ed;
  }
  .team-link {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-top: 22px;
    margin-top: 24px;
    border-top: 1px solid var(--color-sand);
    font-size: 14px;
    font-weight: 800;
    color: var(--color-wine);
  }
  .team-bio {
    margin-top: 20px;
    font-size: 13px;
  }
  .team-bio summary {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    cursor: pointer;
    font-weight: 700;
  }
  .team-bio div p {
    margin-top: 12px;
    color: var(--color-muted);
  }
  .team-footnote {
    margin-top: 30px;
    text-align: center;
    font-size: 13px;
    color: var(--color-muted);
  }
  @media (max-width: 700px) {
    .team-intro,
    .team-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .team-image {
      height: 300px;
    }
    .team-person-copy {
      padding: 24px;
    }
  }
</style>
