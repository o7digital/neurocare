---
import { doctorProfile, services } from '../data/site';
---

<section id="agenda" class="relative overflow-hidden bg-navy py-24 text-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_15%_25%,rgb(227_201_142_/_0.16),transparent_360px),radial-gradient(circle_at_90%_18%,rgb(88_209_201_/_0.18),transparent_360px)]"></div>
  <div class="container-premium grid items-center gap-8 lg:grid-cols-[1fr_0.9fr]">
    <div class="reveal">
      <span class="eyebrow">Agendar consulta</span>
      <h2 class="my-4 text-[42px] font-black leading-[0.98] md:text-7xl">Elige el canal mas comodo para solicitar tu cita.</h2>
      <p class="max-w-2xl text-lg text-white/72">
        Para emergencias medicas o situaciones de riesgo, acude a urgencias o contacta a los servicios locales de emergencia. Este sitio no sustituye una valoracion inmediata.
      </p>
    </div>
    <div class="reveal rounded-[38px] bg-white p-6 text-ink shadow-[0_30px_80px_rgb(0_0_0_/_0.28)]">
      <h3 class="mb-5 text-3xl font-black leading-none">Consulta privada</h3>
      <div class="grid gap-3">
        <a class="btn btn-primary w-full" href={doctorProfile.doctoraliaUrl}>Agendar en Doctoralia</a>
        <a class="btn btn-secondary w-full" href={doctorProfile.phoneHref}>{doctorProfile.phoneLabel}</a>
        <a class="btn btn-secondary w-full" href={doctorProfile.secondaryPhoneHref}>{doctorProfile.secondaryPhoneLabel}</a>
      </div>
      <div class="mt-6 rounded-[24px] border border-line bg-cream p-4">
        <b class="block">{doctorProfile.fullName}</b>
        <span class="text-sm font-bold text-muted">{doctorProfile.specialty} · {doctorProfile.shortLocation}</span>
      </div>
      <div class="mt-4 grid gap-2">
        {services.map((service) => (
          <span class="rounded-2xl border border-line bg-white px-3.5 py-2 text-sm font-bold text-muted">{service}</span>
        ))}
      </div>
    </div>
  </div>
</section>
