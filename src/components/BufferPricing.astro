<section class="buffer-pricing" aria-labelledby="buffer-pricing-heading">
  <div class="pricing-heading">
    <div>
      <span class="small-label">EMPIEZA A TU RITMO</span>
      <h3 id="buffer-pricing-heading">¿Cuánto cuesta Buffer?</h3>
    </div>
    <a href="https://buffer.com/pricing" target="_blank" rel="noreferrer">
      Ver tarifas oficiales ↗
    </a>
  </div>
  <div class="pricing-grid">
    <article>
      <span class="plan-label">FREE</span>
      <p class="plan-price">
        0 <small>USD</small>
      </p>
      <p>
        Hasta <strong>3 canales</strong> y{" "}
        <strong>10 publicaciones en espera por canal</strong>. Al publicarse
        una, se libera su lugar: no son solo los primeros diez posts.
      </p>
    </article>
    <article>
      <span class="plan-label">ESSENTIALS · OPCIONAL</span>
      <p class="plan-price">
        5 <small>USD / mes / canal</small>
      </p>
      <p>
        Con pago anual de <strong>60 USD por canal</strong>. Si prefieres pagar
        mes a mes, son <strong>6 USD por canal al mes</strong>.
      </p>
    </article>
    <article class="price-calculator">
      <label for="buffer-channel-count">Canales que quieres conectar</label>
      <select id="buffer-channel-count">
        <option value="1">1 canal</option>
        <option value="2" selected>
          2 canales · Instagram + Facebook
        </option>
        <option value="3">3 canales</option>
      </select>
      <label for="buffer-billing">Forma de pago de Essentials</label>
      <select id="buffer-billing">
        <option value="annual">Anual · 5 USD/mes/canal equivalentes</option>
        <option value="monthly">Mensual · 6 USD/mes/canal</option>
      </select>
      <p id="buffer-cost" role="status" aria-live="polite">
        10 USD/mes equivalentes · 120 USD pagados al año
      </p>
    </article>
  </div>
  <p class="pricing-footnote">
    La suscripción a Buffer se contrata aparte. Free y Essentials incluyen un
    usuario dentro de Buffer; los dos accesos previstos a esta administración
    son independientes. Tarifas consultadas el 29 de octubre de 2026.
  </p>
</section>
<script>
  const count = document.querySelector<HTMLSelectElement>(
    "#buffer-channel-count",
  );
  const billing = document.querySelector<HTMLSelectElement>("#buffer-billing");
  const cost = document.querySelector("#buffer-cost");
  function updatePrice() {
    if (!count || !billing || !cost) return;
    const channels = Number(count.value);
    cost.textContent =
      billing.value === "annual"
        ? `${channels * 5} USD/mes equivalentes · ${channels * 60} USD pagados al año`
        : `${channels * 6} USD al mes · pago mensual`;
  }
  count?.addEventListener("change", updatePrice);
  billing?.addEventListener("change", updatePrice);
</script>
