---
import { getSiteContent } from '../data/site';

const { authorityPoints, firstConsultationSteps, ui } = getSiteContent(Astro.url.pathname);
---

<section class="section-premium bg-cream/65">
  <div class="container-premium">
    <span class="eyebrow">{ui.medicalApproachEyebrow}</span>
    <h2 class="section-title">{ui.medicalApproachTitle}</h2>
    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {authorityPoints.map((point, index) => (
        <article class="reveal relative min-h-64 overflow-hidden rounded-[8px] border border-sand bg-paper p-7">
          <span class="number-bg">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="relative mb-4 max-w-[220px] text-2xl font-semibold text-text">{point.title}</h3>
          <p class="relative text-muted">{point.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="primera-consulta" class="section-premium bg-paper">
  <div class="container-premium">
    <span class="eyebrow">{ui.firstVisitEyebrow}</span>
    <h2 class="section-title">{ui.firstVisitTitle}</h2>
    <p class="lead">
      {ui.firstVisitLead}
    </p>
    <div class="mt-12 grid gap-8 border-l border-wine/30 pl-6 md:grid-cols-2 md:border-l-0 md:pl-0 lg:grid-cols-4">
      {firstConsultationSteps.map(([step, title, text]) => (
        <article class="reveal relative md:border-t md:border-wine/30 md:pt-7">
          <span class="absolute -left-[31px] top-2 grid h-3 w-3 rounded-full bg-red-clay md:-top-[7px] md:left-0"></span>
          <div class="editorial-serif mb-4 text-4xl text-wine">{step}</div>
          <h3 class="mb-2 text-xl font-semibold text-text">{title}</h3>
          <p class="text-sm text-muted">{text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
